# Copy this file to .env and fill in your own values. .env is gitignored --
# never commit real secrets.

# Required for image/video/music generation (the Image, Frame, Video and
# Music nodes) with the default fal.ai provider. Get a key at
# https://fal.ai/dashboard/keys
FAL_KEY=

# Local image models through ComfyUI instead of fal (images only -- video and
# music still need fal): VISUALS_PROVIDER=comfyui, and where ComfyUI is
# listening. The workflow it runs is set in visuals/data/config.yaml.
VISUALS_PROVIDER=
COMFYUI_URL=http://127.0.0.1:8188

# Only needed if you pick "Claude (API)" as the provider on a Simulation or
# Treatment node (agents/providers/claude.py) -- Ollama remains the default
# and needs no key. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only needed if you pick "OpenAI-compatible (MLX / vLLM / SGLang)" as the
# provider (agents/providers/openai_compat.py). Defaults to mlx_lm.server's
# port; vLLM serves on 8000, SGLang on 30000. The model defaults to the
# first one the server lists; the key only if your server requires one.
OPENAI_COMPAT_BASE_URL=http://localhost:8080/v1
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# CITY mode (agents/city/, the City Simulation node). Optional: force a
# hardware profile (mac | rtx5090 | h100) instead of auto-detecting, and point
# each tier at its own OpenAI-compatible server (one vLLM server usually
# serves one model). Both default to OPENAI_COMPAT_BASE_URL.
CITY_PROFILE=
CITY_HERO_BASE_URL=
CITY_BACKGROUND_BASE_URL=

# Pin the Ollama chat model used for history generation and Ollama-backed
# SCENE runs, instead of auto-picking by GPU/unified memory (which chooses
# gpt-oss:120b on an 80 GB card -- too big to share the GPU with vLLM).
OLLAMA_CHAT_MODEL=

# Serving beyond localhost (e.g. a RunPod public URL): APP_HOST=0.0.0.0 plus a
# login. The app refuses to listen on anything but localhost without a password.
APP_HOST=
APP_USER=
APP_PASSWORD=
