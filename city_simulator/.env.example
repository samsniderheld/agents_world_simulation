# Copy this file to .env and fill in your own values. .env is gitignored --
# never commit real secrets.

# Required for the Visuals tab (image/video generation). Get a key at
# https://fal.ai/dashboard/keys
FAL_KEY=

# Only needed if you pick "Claude" as the agent provider in Start Agents
# (agents/providers/claude.py) -- Ollama remains the default and needs no
# key. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
